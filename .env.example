# Modo de pagamentos: 'asaas' (padrao) ou 'fake' (somente para testes e desenvolvimento local, nunca em producao)
# PAYMENTS_MODE=fake
# Servidor (Vercel) - NUNCA commitar valores reais
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Chave privada da service account, em uma linha, com \n literais entre aspas
FIREBASE_PRIVATE_KEY=
# Vercel Blob (store PRIVADA)
BLOB_READ_WRITE_TOKEN=
# Equipes simultaneas na agenda (padrao 1)
SCHEDULE_TEAMS=1
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_MUNICIPAL_SERVICE_ID=
# Cliente (publico; o repositorio e publico, so coloque aqui o que pode ser exposto)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_API_BASE_URL=
PUBLIC_WHATSAPP_NUMBER=
# Origens extras permitidas no CORS do /api, separadas por virgula (o app Capacitor ja e liberado)
CORS_ORIGINS=
